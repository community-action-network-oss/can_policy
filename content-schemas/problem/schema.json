      "x-guidance": {
        "why": "Stops one thread from turning into everything.",
        "good": "Street lighting in the north district since last March, not other utilities.",
        "bad": "The whole country and everything.",
        "min_chars": 20,
        "max_chars": 400
      },
      "x-checks": {
        "dps": [
          "DP-ELIGIBILITY",
          "DP-FRAMING",
          "DP-DUPLICATE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
