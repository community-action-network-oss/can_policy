      },
      "x-checks": {
        "dps": [
          "DP-EVIDENCE-TIER",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
