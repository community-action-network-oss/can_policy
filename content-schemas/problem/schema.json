    "causal_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 40,
          "maxLength": 600,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.problem.causal_hypothesis.statement.label",
            "help_msg": "schema.problem.causal_hypothesis.statement.help"
          }
        },
        "status": {
          "enum": [
            "untested",
            "partly_supported",
