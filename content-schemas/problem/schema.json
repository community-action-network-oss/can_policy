        "bad": "Mister Example in the lighting office."
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
