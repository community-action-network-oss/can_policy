    "scope": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.problem.scope.label",
        "help_msg": "schema.problem.scope.help",
        "order": 10,
        "group": "scope_outcome"
