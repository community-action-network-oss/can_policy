              "widget": "url",
              "label_msg": "schema.problem.evidence_refs.url.label",
              "help_msg": "schema.problem.evidence_refs.url.help"
            }
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.problem.evidence_refs.description.label",
              "help_msg": "schema.problem.evidence_refs.description.help"
            }
          },
          "supports": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.problem.evidence_refs.supports.label",
              "help_msg": "schema.problem.evidence_refs.supports.help"
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.problem.evidence_refs.label",
        "help_msg": "schema.problem.evidence_refs.help",
        "order": 8,
        "group": "known_sources"
      },
      "x-guidance": {
        "why": "A link is not proof of the fact, so each one says what it supports.",
        "good": "Photo log of the lit and unlit stretch, supports the count of broken lights.",
