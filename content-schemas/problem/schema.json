{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "problem",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "$comment": "Slots reserved for 10-u69: context_profile, stage_plan and affected_area ($ref sub-schemas) and x-ui.group ids context and plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "condition",
    "affected",
    "place",
    "since",
    "observed_facts",
    "uncertain_claims",
    "sources",
    "evidence_refs",
    "causal_hypothesis",
    "scope",
    "responsible_roles",
    "desired_outcome",
    "final_acceptance_criteria",
    "assumptions",
    "out_of_scope",
    "lawful_options"
  ],
  "properties": {
    "condition": {
      "type": "string",
      "minLength": 40,
      "maxLength": 400,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.problem.condition.label",
        "help_msg": "schema.problem.condition.help",
        "order": 1,
        "group": "condition"
      },
      "x-guidance": {
        "why": "Moves the post from a complaint about one case to a condition the public can work on.",
        "good": "Many streets in the north district have no working lights after dark.",
        "bad": "My neighbour never fixes anything and I am furious.",
        "min_chars": 40,
        "max_chars": 400,
        "limits_key": "fields.problem.condition"
      },
      "x-checks": {
        "dps": [
          "DP-ELIGIBILITY",
          "DP-FRAMING",
          "DP-DUPLICATE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "affected": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.problem.affected.label",
        "help_msg": "schema.problem.affected.help",
        "order": 2,
        "group": "affected"
      },
      "x-guidance": {
        "why": "Shows who carries the harm and that the size may not be known yet.",
        "good": "Evening commuters and older residents, size unknown, who avoid the street after dark.",
        "bad": "Everyone.",
        "min_chars": 20,
        "max_chars": 400
      },
      "x-checks": {
        "dps": [
          "DP-ELIGIBILITY",
          "DP-FRAMING",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "coarse_area"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "x-ui": {
            "widget": "text",
            "label_msg": "schema.problem.place.jurisdiction.label",
            "help_msg": "schema.problem.place.jurisdiction.help"
          }
        },
        "coarse_area": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^[^0-9]*$",
          "x-ui": {
            "widget": "text",
            "label_msg": "schema.problem.place.coarse_area.label",
            "help_msg": "schema.problem.place.coarse_area.help"
          }
        }
      },
      "x-ui": {
        "widget": "group",
        "label_msg": "schema.problem.place.label",
        "help_msg": "schema.problem.place.help",
        "order": 3,
        "group": "where_since"
      },
      "x-guidance": {
        "why": "Tells us which law and which office apply, and keeps private addresses out.",
        "good": "Northfold city, north district.",
        "bad": "14 Alder Lane, flat 3."
      },
      "x-checks": {
        "dps": [
          "DP-DUPLICATE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ],
        "no_address": true
      }
    },
    "since": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started",
        "trend"
      ],
      "properties": {
        "started": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "x-ui": {
            "widget": "text",
            "label_msg": "schema.problem.since.started.label",
            "help_msg": "schema.problem.since.started.help"
          }
        },
        "trend": {
          "enum": [
            "recurring",
            "worsening",
            "stable",
            "unknown"
          ],
          "x-ui": {
            "widget": "select",
            "label_msg": "schema.problem.since.trend.label",
            "help_msg": "schema.problem.since.trend.help"
          }
        }
      },
      "x-ui": {
        "widget": "group",
        "label_msg": "schema.problem.since.label",
        "help_msg": "schema.problem.since.help",
        "order": 4,
        "group": "where_since"
      },
      "x-guidance": {
        "why": "The trend matters for finding causes and for deciding what success looks like.",
        "good": "First noticed in March of last year, and worse each winter.",
        "bad": "A long time."
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ],
        "enums": [
          "recurring",
          "worsening",
          "stable",
          "unknown"
        ],
        "allow_unknown": true
      }
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "source_ref",
          "date"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.problem.observed_facts.statement.label",
              "help_msg": "schema.problem.observed_facts.statement.help"
            }
          },
          "source_ref": {
            "type": "string",
            "minLength": 9,
            "maxLength": 300,
            "pattern": "^(firsthand|https?://\\S+)$",
            "x-ui": {
              "widget": "text",
              "label_msg": "schema.problem.observed_facts.source_ref.label",
              "help_msg": "schema.problem.observed_facts.source_ref.help"
            }
          },
          "date": {
            "type": "string",
            "minLength": 4,
            "maxLength": 10,
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "x-ui": {
              "widget": "date",
              "label_msg": "schema.problem.observed_facts.date.label",
              "help_msg": "schema.problem.observed_facts.date.help"
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.problem.observed_facts.label",
        "help_msg": "schema.problem.observed_facts.help",
        "order": 5,
        "group": "known_sources"
      },
      "x-guidance": {
        "why": "Separates what is known from what is believed.",
        "good": "The 2025 council report lists 41 lights out in the north district.",
        "bad": "Everybody knows it is a disaster."
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "uncertain_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "why_uncertain",
          "what_would_settle_it"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.problem.uncertain_claims.statement.label",
              "help_msg": "schema.problem.uncertain_claims.statement.help"
            }
          },
          "why_uncertain": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.problem.uncertain_claims.why_uncertain.label",
              "help_msg": "schema.problem.uncertain_claims.why_uncertain.help"
            }
          },
          "what_would_settle_it": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.problem.uncertain_claims.what_would_settle_it.label",
              "help_msg": "schema.problem.uncertain_claims.what_would_settle_it.help"
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.problem.uncertain_claims.label",
        "help_msg": "schema.problem.uncertain_claims.help",
        "order": 6,
        "group": "known_sources"
      },
      "x-guidance": {
        "why": "Makes uncertainty an ordinary, required part of a post.",
        "good": "Most outages may follow the same fault, but no repair log shows it.",
        "bad": "None."
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/source_ref"
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.problem.sources.label",
        "help_msg": "schema.problem.sources.help",
        "order": 7,
        "group": "known_sources"
      },
      "x-guidance": {
        "why": "A trusted source shows the issue is real. A source is not proof of every claim around it.",
        "good": "Council lighting report, official record, shows the count of lights out.",
        "bad": "I read it somewhere online."
      },
      "x-checks": {
        "dps": [
          "DP-SOURCE-TRUST",
          "DP-EVIDENCE-TIER",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "description",
          "supports"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 9,
            "maxLength": 300,
            "pattern": "^https?://\\S+$",
