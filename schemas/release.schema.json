{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "can_policy/release.schema.json",
  "title": "release.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packs", "released_at"],
  "properties": {
    "version": { "type": "string" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pack_hash"],
        "properties": { "name": { "type": "string" }, "pack_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    },
    "released_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
  }
}
